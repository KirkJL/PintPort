{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beer-passport",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "beer-passport", "database_id": "00000000-0000-4000-8000-000000000000", "migrations_dir": "drizzle"}],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "beer-passport-photos"}],
  "observability": {"enabled": true}
}
